<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>run.boxpool.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/me/Library/Application Support/boxpool/bin/boxpool</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/Users/me/Library/Logs/boxpool/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/me/Library/Logs/boxpool/daemon.log</string>
</dict>
</plist>
